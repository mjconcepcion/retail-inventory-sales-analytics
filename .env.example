# Clover API credentials — copy this file to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real tokens.
#
# Tokens are created in the Clover Merchant Dashboard:
#   Settings -> View all settings -> Business Operations -> API Tokens
# Read-only scopes: Orders, Inventory, Payments, Merchant.
# The merchant ID (mId) is visible in the dashboard URL after login.

CLOVER_STORE1_NAME=Store One
CLOVER_STORE1_MID=XXXXXXXXXXXXX
CLOVER_STORE1_TOKEN=00000000-0000-0000-0000-000000000000

CLOVER_STORE2_NAME=Store Two
CLOVER_STORE2_MID=XXXXXXXXXXXXX
CLOVER_STORE2_TOKEN=00000000-0000-0000-0000-000000000000

# Store 3 (manager access only — no API token): ingest via CSV exports
# dropped into data/private/, see fetch_clover.py notes.
